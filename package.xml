<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>web_tf_editor</name>
  <version>0.2.0</version>
  <description>
    Browser-based, RViz-like 3D viewer for authoring TF frames interactively. Renders the robot
    URDF in a web page, lets you place and drag frames with a 6-DoF gizmo, and broadcasts them
    on /tf through rosbridge.
  </description>
  <maintainer email="f.n.heravi@gmail.com">Farshad Nozad Heravi</maintainer>
  <license>Apache-2.0</license>
  <!-- Third-party JavaScript bundled into web/dist/bundle.js; see web/dist/THIRD_PARTY_NOTICES.txt -->
  <license>MIT</license>
  <license>BSD-2-Clause</license>

  <url type="website">https://github.com/farshad-heravi/web_tf_editor</url>
  <url type="repository">https://github.com/farshad-heravi/web_tf_editor</url>
  <url type="bugtracker">https://github.com/farshad-heravi/web_tf_editor/issues</url>

  <author email="f.n.heravi@gmail.com">Farshad Nozad Heravi</author>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>turtlebot3_manipulation_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
